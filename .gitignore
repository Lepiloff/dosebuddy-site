# IDE
.idea/
.vscode/

# Local Claude Code settings and their atomic-write temp files
.claude/settings.local.json
.claude/*.tmp*

# Renders from tool/ui-shots.sh. Overwritten every run, never a baseline.
build/

# Playwright CLI scratch state, created by `npx playwright`.
.playwright-cli/

# OS
.DS_Store

# Certbot state on the server: private keys and account credentials.
deploy/data/

# The database password. deploy/env.example is the committed documentation.
deploy/.env

# Service account keys. Never in git — a key in history stays valid until it is
# revoked in the console, which nobody remembers to do.
deploy/secrets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local test venv. CI installs from requirements-dev.txt.
api/.venv/

# Sandbox env: throwaway values, but still generated per machine.
deploy/.env.sandbox

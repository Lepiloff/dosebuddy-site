# Copy to deploy/.env on the server. Never committed — .env is gitignored.
#
# Create it once, with a generated password:
#
#   cd /home/ubuntu/dosebuddy-site/deploy
#   { echo "POSTGRES_USER=dosebuddy"
#     echo "POSTGRES_DB=dosebuddy"
#     echo "POSTGRES_PASSWORD=$(openssl rand -base64 32 | tr -d '/+=' | head -c 40)"
#   } > .env
#   chmod 600 .env
#
# Changing POSTGRES_PASSWORD afterwards does not change the password Postgres
# already stored — that is set once, when the data volume is initialised. To
# rotate it later, ALTER USER inside the database and update this file to match.

POSTGRES_USER=dosebuddy
POSTGRES_DB=dosebuddy
POSTGRES_PASSWORD=

# Signs access tokens and keys the pairing-code HMAC.
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48
JWT_SECRET=

# 32 bytes, base64. Encrypts medication names, profile names and notes.
#   openssl rand -base64 32
#
# **Back this up.** It is not derivable and not recoverable: lose it and the
# encrypted columns are gone, database intact. Keep it wherever the rest of this
# box's secrets live, not only on the box.
ENCRYPTION_KEY=

# OAuth client id from Google Cloud, used as the audience when verifying an ID
# token. Empty disables Google sign-in rather than accepting anything: without
# an audience, a token Google issued for any other app would be accepted.
GOOGLE_CLIENT_ID=

# Optional; the defaults in docker-compose.yml are fine.
LOG_LEVEL=INFO

# Leave false in production. The API schema is not secret, but a service
# holding article 9 health data has no reason to publish its surface.
DOCS_ENABLED=false

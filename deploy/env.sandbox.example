# Copy to deploy/.env.sandbox. Throwaway values — this database holds nothing
# real and is destroyed by `down -v`.
#
#   cd deploy
#   { echo "POSTGRES_USER=dosebuddy"
#     echo "POSTGRES_DB=dosebuddy"
#     echo "POSTGRES_PASSWORD=sandbox"
#     echo "JWT_SECRET=sandbox-not-a-secret"
#     echo "ENCRYPTION_KEY=$(openssl rand -base64 32)"
#     echo "GOOGLE_CLIENT_ID="
#   } > .env.sandbox
#
# ENCRYPTION_KEY must still be 32 bytes base64 — the encrypted columns are real
# code, not a stub, and the app refuses to start without a usable key.
#
# GOOGLE_CLIENT_ID empty disables Google sign-in. Set it to the same Web client
# id as production if you want to sign in from a real phone build.
POSTGRES_USER=dosebuddy
POSTGRES_DB=dosebuddy
POSTGRES_PASSWORD=sandbox
JWT_SECRET=sandbox-not-a-secret
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
